<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SecureSharedPreference"
            android:textColor="#14243A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Encrypted local storage demo"
            android:textColor="#627187"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preference key"
                android:textColor="#24364B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#5878A5"
                android:hint="For example, username"
                android:inputType="text"
                android:padding="10dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Value"
                android:textColor="#24364B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:backgroundTint="#5878A5"
                android:gravity="top|start"
                android:hint="Type a value to encrypt"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2457A6"
                android:text="Save encrypted value"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#E8EEF7"
                android:text="Load and decrypt"
                android:textAllCaps="false"
                android:textColor="#1C3C68" />

            <Button
                android:id="@+id/btnContains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#E8EEF7"
                android:text="Check if key exists"
                android:textAllCaps="false"
                android:textColor="#1C3C68" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRemove"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E8EEF7"
                    android:text="Remove key"
                    android:textAllCaps="false"
                    android:textColor="#1C3C68" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F8E9E9"
                    android:text="Clear all"
                    android:textAllCaps="false"
                    android:textColor="#8B2929" />
            </LinearLayout>

            <Button
                android:id="@+id/btnRunTests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E8EEF7"
                android:text="Run all checks"
                android:textAllCaps="false"
                android:textColor="#1C3C68" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="Activity"
            android:textColor="#24364B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:fontFamily="monospace"
            android:minHeight="112dp"
            android:padding="16dp"
            android:text="Starting secure storage..."
            android:textColor="#33445B"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Values are stored locally and encrypted with Android Keystore."
            android:textColor="#718096"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
