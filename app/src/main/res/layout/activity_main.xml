<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 SecureSharedPreference"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AES-256-GCM · Android KeyStore · Zero Dependencies"
            android:textSize="13sp"
            android:textColor="#607D8B"
            android:layout_marginBottom="20dp" />

        <!-- Input section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Key"
            android:textSize="13sp"
            android:textColor="#37474F"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. username"
            android:inputType="text"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Value"
            android:textSize="13sp"
            android:textColor="#37474F"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. john_doe"
            android:inputType="text"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save"
                android:backgroundTint="#1565C0"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLoad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Load"
                android:backgroundTint="#2E7D32"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnRemove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Remove"
                android:backgroundTint="#E65100"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear All"
                android:backgroundTint="#B71C1C"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Run all tests button -->
        <Button
            android:id="@+id/btnRunTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶  Run All Type Tests"
            android:backgroundTint="#4A148C"
            android:layout_marginBottom="20dp" />

        <!-- Output -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#212121"
            android:text="Tap a button to begin…" />

    </LinearLayout>
</ScrollView>
